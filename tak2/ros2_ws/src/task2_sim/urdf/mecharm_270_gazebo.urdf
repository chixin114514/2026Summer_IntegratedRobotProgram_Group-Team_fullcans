<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecharm_270_pi" >

  <!--
    Physical mounting condition:
    the real MechArm base is rigidly fixed to the workbench.
    Gazebo therefore fixes the robot base to the world.
  -->

  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


	
<xacro:property name="width" value=".2" />


  <link name="base">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.80"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>

    <visual>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/base.dae"/>
      </geometry>
      <origin xyz = " 0 0 0 " rpy = " 0 0 -3.1415926"/>
    </visual>
    <collision>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
        <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/base.dae"/>
      </geometry>
      <origin xyz = " 0 0 0 " rpy = " 0 0 -3.1415926"/>
    </collision>

  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.0006"/>
    </inertial>

    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link1.dae"/>
      </geometry>
      <origin xyz = "0 0 -0.132 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link1.dae"/>
      </geometry>
      <origin xyz = "0 0 -0.132 " rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0 -0.05 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0012" ixy="0" ixz="0"
               iyy="0.0006" iyz="0" izz="0.0012"/>
    </inertial>

    <visual>
      <geometry>    
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link2.dae"/>
      </geometry>
      <origin xyz = "-0.005 0.21 0.002  " rpy = " 1.5708 -3.1415926 0"/>

    </visual>
    <collision>
      <geometry>    
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link2.dae"/>
      </geometry>
      <origin xyz = "-0.005  -0.21 0.002  " rpy = " 1.5708 -3.1415926 0"/>
      
    </collision>     
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>

    <visual>
      <geometry> 
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link3.dae"/>
      </geometry>
      <origin xyz = "-0.09 0.306 0.005 " rpy = "1.5708 3.1415926  0"/>
      <!-- <origin xyz = "-0.0 0.0 0.000 " rpy = "0 0  0"/> -->
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link3.dae"/>
      </geometry>
      <origin xyz = "-0.09 0.306 0.005" rpy = "1.5708 3.1415926 0"/>
    </collision>
  </link>

  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link4.dae"/>
      </geometry>
      <origin xyz = "0.009 -0.311 -0.228" rpy = " 0 1.5708 1.5708"/>
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link4.dae"/>
      </geometry>
    <origin xyz = "0.009 -0.311  -0.228" rpy = " 0 1.5708  1.5708"/>
    </collision>
  </link>

  <link name="link5">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link5.dae"/>
      </geometry>
      <origin xyz = "-0.292 -0.318 -0.007" rpy = " 1.5708 0 3.1415926"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link5.dae"/>
      </geometry>
      <origin xyz = "-0.292 -0.318 -0.007 " rpy = " 1.5708 0 3.1415926"/>
    </collision>
  </link>

  <link name="link6">
    <inertial>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.00025" iyz="0" izz="0.00025"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link6.dae"/>
      </geometry>
      <origin xyz = "-0.1645 0.0536 -0.211 " rpy = " 0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link6.dae"/>
      </geometry>
      <origin xyz = "-0.1645 0.0536 -0.211 " rpy = " 0 1.5708 0"/>
    </collision>
  </link>


  <joint name="joint1_to_base" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.792527" upper = "2.792527" velocity="1.5"/>
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz= "0 0 0.1" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-1.3089" upper = "2.0943" velocity="1.5"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz= "0 0 0.038" rpy = " -1.5708 0 0 "/>  
  </joint>


  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-3.0543" upper = "1.1344" velocity="1.5"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz= "0.0 -0.1 0   " rpy = "0 0 0 "/>  
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-2.7052" upper = "2.7052" velocity="1.5"/>
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz= "0.108 -0.005  -0.001" rpy = "0 1.5708 0 "/>  
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.0071" upper = "2.0071" velocity="1.5"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz= " -0.001 0 0.0" rpy = "  0 -1.5708 0"/>  
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14" velocity="1.5"/>
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz= " 0.06 0.00 -0.0" rpy = "  0 1.5708 0 "/>  
  </joint>
  


  <!-- Gazebo joint position controllers -->

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1_to_base</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint1/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2_to_joint1</joint_name>

      <initial_position>-0.349066</initial_position>
      <topic>/task2/joint2/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3_to_joint2</joint_name>

      <initial_position>-1.22173</initial_position>
      <topic>/task2/joint3/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint4_to_joint3</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint4/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.25</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint5_to_joint4</joint_name>

      <initial_position>1.570796</initial_position>
      <topic>/task2/joint5/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.25</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint6_to_joint5</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint6/cmd_pos</topic>
      <p_gain>4.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.20</d_gain>
    </plugin>
  </gazebo>



  <!-- ====================================================== -->
  <!-- Gazebo measured joint-state publisher                  -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">

      <joint_name>joint1_to_base</joint_name>
      <joint_name>joint2_to_joint1</joint_name>
      <joint_name>joint3_to_joint2</joint_name>
      <joint_name>joint4_to_joint3</joint_name>
      <joint_name>joint5_to_joint4</joint_name>
      <joint_name>joint6_to_joint5</joint_name>

      <topic>
        /task2/gazebo/joint_state
      </topic>

    </plugin>

  </gazebo>



  <!-- ====================================================== -->
  <!-- Physical two-finger gripper                            -->
  <!-- ====================================================== -->

  <link name="gripper_palm">

    <visual>
      <origin xyz="0 0 0.0075"/>
      <geometry>
        <box size="0.078 0.026 0.015"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.12 0.12 0.14 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.0075"/>
      <geometry>
        <box size="0.078 0.026 0.015"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0075"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00008"
        ixy="0"
        ixz="0"
        iyy="0.00008"
        iyz="0"
        izz="0.00008"/>
    </inertial>

  </link>


  <!-- Mount palm on joint 6 -->

  <joint name="gripper_mount" type="fixed">

    <parent link="link6"/>
    <child link="gripper_palm"/>

    <origin
      xyz="0 0 0.005"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Left finger                                            -->
  <!-- ====================================================== -->

  <link name="left_finger">

    <visual>
      <origin xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.008 0.014 0.055"/>
      </geometry>
      <material name="gripper_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.008 0.014 0.055"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0275"/>
      <mass value="0.025"/>
      <inertia
        ixx="0.00002"
        ixy="0"
        ixz="0"
        iyy="0.00002"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint
    name="left_finger_joint"
    type="prismatic">

    <parent link="gripper_palm"/>
    <child link="left_finger"/>

    <origin
      xyz="0.0265 0 0.015"
      rpy="0 0 0"/>

    <!-- Positive motion moves toward centre -->
    <axis xyz="-1 0 0"/>

    <limit
      lower="0.0"
      upper="0.0125"
      effort="60"
      velocity="0.04"/>

    <dynamics
      damping="1.0"
      friction="0.5"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Right finger                                           -->
  <!-- ====================================================== -->

  <link name="right_finger">

    <visual>
      <origin xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.008 0.014 0.055"/>
      </geometry>
      <material name="gripper_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0275"/>
      <geometry>
        <box size="0.008 0.014 0.055"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0275"/>
      <mass value="0.025"/>
      <inertia
        ixx="0.00002"
        ixy="0"
        ixz="0"
        iyy="0.00002"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint
    name="right_finger_joint"
    type="prismatic">

    <parent link="gripper_palm"/>
    <child link="right_finger"/>

    <origin
      xyz="-0.0265 0 0.015"
      rpy="0 0 0"/>

    <!-- Positive motion moves toward centre -->
    <axis xyz="1 0 0"/>

    <limit
      lower="0.0"
      upper="0.0125"
      effort="60"
      velocity="0.04"/>

    <dynamics
      damping="1.0"
      friction="0.5"/>

  </joint>


  <!-- ====================================================== -->
  <!-- Finger position controllers                            -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>
        left_finger_joint
      </joint_name>

      <topic>
        /task2/gripper/left_cmd_pos
      </topic>

      <p_gain>250.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>8.0</d_gain>

      <initial_position>0.0</initial_position>

    </plugin>


    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>
        right_finger_joint
      </joint_name>

      <topic>
        /task2/gripper/right_cmd_pos
      </topic>

      <p_gain>250.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>8.0</d_gain>

      <initial_position>0.0</initial_position>

    </plugin>

  </gazebo>


  <!-- ====================================================== -->
  





  <!-- High-friction rubber-like finger surfaces -->

  <gazebo reference="left_finger">
    <mu1>4.0</mu1>
    <mu2>4.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.02</maxVel>
  </gazebo>

  <gazebo reference="right_finger">
    <mu1>4.0</mu1>
    <mu2>4.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.02</maxVel>
  </gazebo>


</robot>