<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecharm_270_pi" >

  <!--
    Physical mounting condition:
    the real MechArm base is rigidly fixed to the workbench.
    Gazebo therefore fixes the robot base to the world.
  -->

  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


	
<xacro:property name="width" value=".2" />


  <link name="base">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.80"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>

    <visual>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/base.dae"/>
      </geometry>
      <origin xyz = " 0 0 0 " rpy = " 0 0 -3.1415926"/>
    </visual>
    <collision>
      <geometry>
	     <!--- 0.0 0 -0.04  1.5708 3.14159-->
        <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/base.dae"/>
      </geometry>
      <origin xyz = " 0 0 0 " rpy = " 0 0 -3.1415926"/>
    </collision>

  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.0006"/>
    </inertial>

    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link1.dae"/>
      </geometry>
      <origin xyz = "0 0 -0.132 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link1.dae"/>
      </geometry>
      <origin xyz = "0 0 -0.132 " rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="link2">
    <inertial>
      <origin xyz="0 -0.05 0" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.0012" ixy="0" ixz="0"
               iyy="0.0006" iyz="0" izz="0.0012"/>
    </inertial>

    <visual>
      <geometry>    
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link2.dae"/>
      </geometry>
      <origin xyz = "-0.005 0.21 0.002  " rpy = " 1.5708 -3.1415926 0"/>

    </visual>
    <collision>
      <geometry>    
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link2.dae"/>
      </geometry>
      <origin xyz = "-0.005  -0.21 0.002  " rpy = " 1.5708 -3.1415926 0"/>
      
    </collision>     
  </link>

  <link name="link3">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>

    <visual>
      <geometry> 
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link3.dae"/>
      </geometry>
      <origin xyz = "-0.09 0.306 0.005 " rpy = "1.5708 3.1415926  0"/>
      <!-- <origin xyz = "-0.0 0.0 0.000 " rpy = "0 0  0"/> -->
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link3.dae"/>
      </geometry>
      <origin xyz = "-0.09 0.306 0.005" rpy = "1.5708 3.1415926 0"/>
    </collision>
  </link>

  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link4.dae"/>
      </geometry>
      <origin xyz = "0.009 -0.311 -0.228" rpy = " 0 1.5708 1.5708"/>
    </visual>
    <collision>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link4.dae"/>
      </geometry>
    <origin xyz = "0.009 -0.311  -0.228" rpy = " 0 1.5708  1.5708"/>
    </collision>
  </link>

  <link name="link5">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link5.dae"/>
      </geometry>
      <origin xyz = "-0.292 -0.318 -0.007" rpy = " 1.5708 0 3.1415926"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link5.dae"/>
      </geometry>
      <origin xyz = "-0.292 -0.318 -0.007 " rpy = " 1.5708 0 3.1415926"/>
    </collision>
  </link>

  <link name="link6">
    <inertial>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.00025" iyz="0" izz="0.00025"/>
    </inertial>

    <visual>
      <geometry>
       <!--- 0.0 0 -0.04 -->
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link6.dae"/>
      </geometry>
      <origin xyz = "-0.1645 0.0536 -0.211 " rpy = " 0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mecharm_270_m5/link6.dae"/>
      </geometry>
      <origin xyz = "-0.1645 0.0536 -0.211 " rpy = " 0 1.5708 0"/>
    </collision>
  </link>


  <joint name="joint1_to_base" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.792527" upper = "2.792527" velocity="1.5"/>
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz= "0 0 0.1" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-1.3089" upper = "2.0943" velocity="1.5"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz= "0 0 0.038" rpy = " -1.5708 0 0 "/>  
  </joint>


  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-3.0543" upper = "1.1344" velocity="1.5"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz= "0.0 -0.1 0   " rpy = "0 0 0 "/>  
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-2.7052" upper = "2.7052" velocity="1.5"/>
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz= "0.108 -0.005  -0.001" rpy = "0 1.5708 0 "/>  
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.0071" upper = "2.0071" velocity="1.5"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz= " -0.001 0 0.0" rpy = "  0 -1.5708 0"/>  
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14" velocity="1.5"/>
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz= " 0.06 0.00 -0.0" rpy = "  0 1.5708 0 "/>  
  </joint>
  


  <!-- Gazebo joint position controllers -->

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1_to_base</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint1/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2_to_joint1</joint_name>

      <initial_position>0.003759439</initial_position>
      <topic>/task2/joint2/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3_to_joint2</joint_name>

      <initial_position>-0.356478264</initial_position>
      <topic>/task2/joint3/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.4</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint4_to_joint3</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint4/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.25</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint5_to_joint4</joint_name>

      <initial_position>1.923513406</initial_position>
      <topic>/task2/joint5/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.25</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint6_to_joint5</joint_name>

      <initial_position>0.0</initial_position>
      <topic>/task2/joint6/cmd_pos</topic>
      <p_gain>4.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.20</d_gain>
    </plugin>
  </gazebo>



  <!-- ====================================================== -->
  <!-- Gazebo measured joint-state publisher                  -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">

      <joint_name>joint1_to_base</joint_name>
      <joint_name>joint2_to_joint1</joint_name>
      <joint_name>joint3_to_joint2</joint_name>
      <joint_name>joint4_to_joint3</joint_name>
      <joint_name>joint5_to_joint4</joint_name>
      <joint_name>joint6_to_joint5</joint_name>

      <topic>
        /task2/gazebo/joint_state
      </topic>

    </plugin>

  </gazebo>



  <!-- ====================================================== -->
  <!-- myCobot Adaptive Gripper AG                            -->
  <!-- ====================================================== -->
  <!-- Rotational adaptive linkage; task interface unchanged. -->
  <!-- q_open=+0.14 rad, q_closed=-0.50 rad.                  -->
  <!-- Effective pad span is approximately 46 mm to 20 mm.    -->
  <!-- ====================================================== -->

  <link name="gripper_palm">

    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.055 0.030"/>
      </geometry>
      <material name="ag_white">
        <color rgba="0.92 0.92 0.90 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.062 0.050 0.026"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <mass value="0.090"/>
      <inertia
        ixx="0.00010" ixy="0" ixz="0"
        iyy="0.00010" iyz="0"
        izz="0.00010"/>
    </inertial>

  </link>


  <joint name="gripper_mount" type="fixed">
    <parent link="link6"/>
    <child link="gripper_palm"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>


  <!-- LEFT linkage -->

  <link name="gripper_left3">

    <visual>
      <origin xyz="-0.0135 0 0.0080" rpy="0 -1.036 0"/>
      <geometry>
        <box size="0.008 0.010 0.0315"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <collision>
      <origin xyz="-0.0135 0 0.0080" rpy="0 -1.036 0"/>
      <geometry>
        <box size="0.008 0.010 0.0315"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.0135 0 0.0080" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia
        ixx="0.00001" ixy="0" ixz="0"
        iyy="0.00001" iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint name="gripper_controller" type="revolute">

    <parent link="gripper_palm"/>
    <child link="gripper_left3"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="-0.012 0 0.005" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.70"
      upper="0.15"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <link name="gripper_left1">

    <visual>
      <origin xyz="0.013 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.022 0.034"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <!-- Large rubber gripping pad -->
    <visual>
      <origin xyz="0.020 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.030 0.034"/>
      </geometry>
      <material name="ag_dark">
        <color rgba="0.10 0.10 0.11 1"/>
      </material>
    </visual>

    <!-- Recessed structural finger collision -->
    <collision name="left_finger_body_collision">
      <origin xyz="0.010 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.022 0.030"/>
      </geometry>
    </collision>

    <!-- Actual rubber gripping surface -->
    <collision name="left_grip_pad_collision">
      <origin xyz="0.020 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.030 0.034"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.013 0 0.022" rpy="0 0 0"/>
      <mass value="0.018"/>
      <inertia
        ixx="0.000015" ixy="0" ixz="0"
        iyy="0.000015" iyz="0"
        izz="0.000010"/>
    </inertial>

  </link>


  <joint
    name="gripper_left3_to_gripper_left1"
    type="revolute">

    <parent link="gripper_left3"/>
    <child link="gripper_left1"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="-0.027 0 0.016" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.50"
      upper="0.50"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <link name="gripper_left2">

    <visual>
      <origin xyz="-0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.008 0.008"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <collision>
      <origin xyz="-0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.008 0.008"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.015 0 0" rpy="0 0 0"/>
      <mass value="0.010"/>
      <inertia
        ixx="0.000008" ixy="0" ixz="0"
        iyy="0.000008" iyz="0"
        izz="0.000008"/>
    </inertial>

  </link>


  <joint
    name="gripper_base_to_gripper_left2"
    type="revolute">

    <parent link="gripper_palm"/>
    <child link="gripper_left2"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="-0.005 0 0.027" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.80"
      upper="0.50"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <!-- RIGHT linkage -->

  <link name="gripper_right3">

    <visual>
      <origin xyz="0.0135 0 0.0080" rpy="0 1.036 0"/>
      <geometry>
        <box size="0.008 0.010 0.0315"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <collision>
      <origin xyz="0.0135 0 0.0080" rpy="0 1.036 0"/>
      <geometry>
        <box size="0.008 0.010 0.0315"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0135 0 0.0080" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia
        ixx="0.00001" ixy="0" ixz="0"
        iyy="0.00001" iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>


  <joint
    name="gripper_base_to_gripper_right3"
    type="revolute">

    <parent link="gripper_palm"/>
    <child link="gripper_right3"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="0.012 0 0.005" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.15"
      upper="0.70"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <link name="gripper_right1">

    <visual>
      <origin xyz="-0.013 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.022 0.034"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <!-- Large rubber gripping pad -->
    <visual>
      <origin xyz="-0.020 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.030 0.034"/>
      </geometry>
      <material name="ag_dark"/>
    </visual>

    <!-- Recessed structural finger collision -->
    <collision name="right_finger_body_collision">
      <origin xyz="-0.010 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.022 0.030"/>
      </geometry>
    </collision>

    <!-- Actual rubber gripping surface -->
    <collision name="right_grip_pad_collision">
      <origin xyz="-0.020 0 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.030 0.034"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.013 0 0.022" rpy="0 0 0"/>
      <mass value="0.018"/>
      <inertia
        ixx="0.000015" ixy="0" ixz="0"
        iyy="0.000015" iyz="0"
        izz="0.000010"/>
    </inertial>

  </link>


  <joint
    name="gripper_right3_to_gripper_right1"
    type="revolute">

    <parent link="gripper_right3"/>
    <child link="gripper_right1"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="0.027 0 0.016" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.50"
      upper="0.50"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <link name="gripper_right2">

    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.008 0.008"/>
      </geometry>
      <material name="ag_white"/>
    </visual>

    <collision>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.008 0.008"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <mass value="0.010"/>
      <inertia
        ixx="0.000008" ixy="0" ixz="0"
        iyy="0.000008" iyz="0"
        izz="0.000008"/>
    </inertial>

  </link>


  <joint
    name="gripper_base_to_gripper_right2"
    type="revolute">

    <parent link="gripper_palm"/>
    <child link="gripper_right2"/>

    <axis xyz="0 -1 0"/>

    <origin xyz="0.005 0 0.027" rpy="0 0 0"/>

    <limit
      effort="8.0"
      lower="-0.50"
      upper="0.80"
      velocity="1.2"/>

    <dynamics damping="0.20" friction="0.05"/>

  </joint>


  <!-- Gazebo linkage position controllers -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_controller</joint_name>
      <topic>/task2/gripper/left3_cmd_pos</topic>
      <p_gain>18.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.8</d_gain>
      <initial_position>0.14</initial_position>
    </plugin>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_base_to_gripper_left2</joint_name>
      <topic>/task2/gripper/left2_cmd_pos</topic>
      <p_gain>18.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.8</d_gain>
      <initial_position>0.14</initial_position>
    </plugin>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>gripper_left3_to_gripper_left1</joint_name>
      <topic>/task2/gripper/left1_cmd_pos</topic>
