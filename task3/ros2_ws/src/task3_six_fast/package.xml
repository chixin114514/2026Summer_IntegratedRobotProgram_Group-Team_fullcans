<?xml version="1.0"?>
<package format="3">
  <name>task3_six_fast</name>
  <version>0.1.0</version>
  <description>
    Faster variant of the six-object yellow/green sorting simulation.  Reuses the
    scene, world and robot description of task3_six_sim unchanged; only the step
    accuracy budget and the arm compensation differ.
  </description>
  <maintainer email="team@example.com">Integrated Robot Program Group Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_ign_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>task3_interfaces</exec_depend>
  <exec_depend>task3_sim</exec_depend>
  <exec_depend>task3_six_sim</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
